

class Solution {
  public:
        vector<int> leaders(vector<int>& arr) {
        
        vector<int> v;
        int maxRight = INT_MIN;
        
        for(int i = arr.size() - 1; i >= 0; i--) {
            if(arr[i] >= maxRight) {
                v.push_back(arr[i]);
                maxRight = arr[i];
            }
        }
        
        reverse(v.begin(), v.end());
        return v;
        

    }
};
